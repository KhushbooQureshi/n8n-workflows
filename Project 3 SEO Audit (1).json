    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.content.parts[0].text;\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 40px; color: #333; }\n  h1 { color: #1a1a2e; border-bottom: 3px solid #e74c3c; padding-bottom: 10px; }\n  h2 { color: #16213e; margin-top: 30px; }\n  h3 { color: #0f3460; }\n  pre { white-space: pre-wrap; line-height: 1.8; font-family: Arial, sans-serif; }\n  .header { background: #1a1a2e; color: white; padding: 30px; border-radius: 8px; margin-bottom: 30px; }\n  .header h1 { color: white; border: none; }\n  .footer { margin-top: 40px; text-align: center; color: #999; font-size: 12px; }\n</style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>SEO Audit Report</h1>\n    <p>Generated on ${new Date().toLocaleDateString()}</p>\n  </div>\n  <pre>${aiOutput}</pre>\n  <div class=\"footer\">Generated by AI SEO Audit System</div>\n</body>\n</html>`;\n\nreturn [{ json: { html } }];"
      },
