    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst mobileData = allItems[0].json.lighthouseResult;\nconst desktopData = allItems[1].json.lighthouseResult;\nconst waybackData = allItems[2].json;\n\n// Calculate domain age from wayback timestamp\nlet domainAge = 'Unknown';\nif (waybackData?.archived_snapshots?.closest?.timestamp) {\n  const timestamp = waybackData.archived_snapshots.closest.timestamp;\n  const year = timestamp.substring(0, 4);\n  const month = timestamp.substring(4, 6);\n  const day = timestamp.substring(6, 8);\n  const firstSeen = new Date(`${year}-${month}-${day}`);\n  const today = new Date();\n  const diffMonths = Math.round((today - firstSeen) / (1000 * 60 * 60 * 24 * 30));\n  domainAge = `${diffMonths} months`;\n}\n\nreturn [{\n  json: {\n    domain: mobileData.requestedUrl || mobileData.finalUrl,\n    fetchTime: mobileData.fetchTime,\n    domainAge: domainAge,\n    firstSeenUrl: waybackData?.archived_snapshots?.closest?.url || 'Not found',\n\n    mobile: {\n      performance: Math.round((mobileData.categories?.performance?.score || 0) * 100),\n      fcp: mobileData.audits?.['first-contentful-paint']?.displayValue,\n      lcp: mobileData.audits?.['largest-contentful-paint']?.displayValue,\n      tbt: mobileData.audits?.['total-blocking-time']?.displayValue,\n      cls: mobileData.audits?.['cumulative-layout-shift']?.displayValue,\n      speedIndex: mobileData.audits?.['speed-index']?.displayValue,\n    },\n    desktop: {\n      performance: Math.round((desktopData.categories?.performance?.score || 0) * 100),\n      fcp: desktopData.audits?.['first-contentful-paint']?.displayValue,\n      lcp: desktopData.audits?.['largest-contentful-paint']?.displayValue,\n      tbt: desktopData.audits?.['total-blocking-time']?.displayValue,\n      cls: desktopData.audits?.['cumulative-layout-shift']?.displayValue,\n      speedIndex: desktopData.audits?.['speed-index']?.displayValue,\n    }\n  }\n}];"
      },
