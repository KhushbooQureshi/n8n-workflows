          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and categorize it.\n\nSubject: {{ $json.subject }}\nFrom: {{ $json.from }}\nEmail Content: {{ $json.snippet }}\n\nReturn ONLY this JSON format:\n{\n  \"category\": \"High Priority / Medium Priority / Low Priority / Promotional / Spam\",\n  \"label\": \"HIGH_PRIORITY / MEDIUM_PRIORITY / LOW_PRIORITY / PROMOTIONAL / SPAM\",\n  \"reason\": \"why this category\",\n  \"action_needed\": \"yes / no\",\n  \"draft_reply\": \"a professional reply to this email\"\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        208,
        0
      ],
      "id": "------",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        80,
        208
      ],
      "id": "------",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "-----",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "=Re: {{ $('Gmail Trigger').item.json.subject }}",
        "message": "={{ $('AI Agent').item.json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ],
      "id": "----",
      "name": "Create a draft",
      "webhookId": "----",
